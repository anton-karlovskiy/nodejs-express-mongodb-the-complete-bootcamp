{
  "name": "natours",
  "version": "2.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "watch:js": "parcel watch public/js/index.js --dist-dir public/js --out-file bundle.js",
    "build:js": "parcel build public/js/index.js --dist-dir public/js --out-file bundle.js",
    "import-data": "tsx src/dev-data/import-dev-data.ts --import",
    "delete-data": "tsx src/dev-data/import-dev-data.ts --delete"
  },
  "author": "Jonas Schmedtmann",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pug": "^3.0.3",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "stripe": "^17.6.0",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.6",
    "@types/html-to-text": "^9.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pug": "^2.0.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/validator": "^13.12.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "parcel": "^2.13.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
